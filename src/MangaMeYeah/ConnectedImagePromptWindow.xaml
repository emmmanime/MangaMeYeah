<Window x:Class="MangaMeYeah.ConnectedImagePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="連結画像の検出"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F5F5F5">
    <StackPanel Margin="18,16,18,14">
        <TextBlock x:Name="MessageTextBlock"
                   Text="連結画像を検出しました。連結表示に切り替えますか？"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <CheckBox x:Name="SuppressPromptCheckBox"
                  Content="以降、連結画像を検出しても問い合わせない"
                  Margin="0,0,0,16" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="表示する(_Y)"
                    Width="105"
                    Height="28"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="YesButton_Click" />
            <Button Content="表示しない(_N)"
                    Width="105"
                    Height="28"
                    IsCancel="True"
                    Click="NoButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
