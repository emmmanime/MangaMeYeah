<Window x:Class="MangaMeYeah.ImageInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="画像情報"
        SizeToContent="WidthAndHeight"
        MaxWidth="1520"
        MaxHeight="860"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#F0F0F0">
    <Grid Margin="6,6,6,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 複数枚表示のレイアウト（横2/縦2/横3/縦3/横4/縦4/2×2）通りにセルが並ぶコンテナ -->
        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Grid x:Name="InfoLayoutGrid" />
        </ScrollViewer>

        <!-- 下部 OK ボタン (MangaMeeya 準拠の中央配置) -->
        <Button Grid.Row="1"
                Content="OK"
                Width="105"
                Height="26"
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                IsDefault="True"
                IsCancel="True"
                Click="OkButton_Click" />
    </Grid>
</Window>
