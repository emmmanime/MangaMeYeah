<Window x:Class="MangaMeYeah.VersionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="バージョン情報"
        Width="380"
        Height="165"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F0F0F0">
    <Grid Margin="18,16,18,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左側アプリアイコン (本家MangaMeeya風) -->
        <Image Grid.Column="0"
               Source="pack://application:,,,/Assets/MangaMeYeah.ico"
               Width="48"
               Height="48"
               Margin="0,0,16,0"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <!-- 右側コンテンツ (センタリング) -->
        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <!-- 「マンガミーヤー vX.X.X」 -->
            <TextBlock x:Name="VersionTextBlock"
                       Text="マンガミーヤー v0.3.5"
                       FontSize="13"
                       Foreground="#000000"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6" />

            <!-- URLリンク -->
            <TextBlock HorizontalAlignment="Center"
                       Margin="0,0,0,12"
                       FontSize="12">
                <Hyperlink NavigateUri="https://github.com/emmmanime/MangaMeYeah"
                           RequestNavigate="Hyperlink_RequestNavigate"
                           Foreground="#0000FF">
                    https://github.com/emmmanime/MangaMeYeah
                </Hyperlink>
            </TextBlock>

            <!-- OKボタン (センタリング) -->
            <Button Content="OK"
                    Width="82"
                    Height="24"
                    HorizontalAlignment="Center"
                    IsDefault="True"
                    IsCancel="True"
                    Click="OkButton_Click" />
        </StackPanel>
    </Grid>
</Window>
