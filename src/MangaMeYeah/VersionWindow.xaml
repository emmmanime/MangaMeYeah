<Window x:Class="MangaMeYeah.VersionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="バージョン情報"
        Icon="pack://application:,,,/Assets/MangaMeYeah.ico"
        Width="430"
        Height="270"
        SizeToContent="WidthAndHeight"
        MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FFFFFF">
    <Grid Margin="32,24,32,24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- アプリアイコン (中央・シャドウ付き) -->
            <Image Source="pack://application:,,,/Assets/MangaMeYeah_Logo.png"
                   Width="88"
                   Height="88"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,14"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <DropShadowEffect BlurRadius="12"
                                      Direction="270"
                                      ShadowDepth="4"
                                      Opacity="0.28"
                                      Color="#000000" />
                </Image.Effect>
            </Image>

            <!-- アプリ名・バージョン番号 (中央・太字) -->
            <TextBlock x:Name="VersionTextBlock"
                       Text="マンガミーヤー v0.3.5"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#1A1A1A"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8" />

            <!-- GitHub URL リンク (中央・下線付き青文字) -->
            <TextBlock HorizontalAlignment="Center"
                       FontSize="13"
                       Margin="0,0,0,18">
                <Hyperlink NavigateUri="https://github.com/emmmanime/MangaMeYeah"
                           RequestNavigate="Hyperlink_RequestNavigate"
                           Foreground="#0969DA">
                    https://github.com/emmmanime/MangaMeYeah
                </Hyperlink>
            </TextBlock>

            <!-- OKボタン (中央配置) -->
            <Button Content="OK"
                    Width="96"
                    Height="28"
                    FontSize="12"
                    HorizontalAlignment="Center"
                    IsDefault="True"
                    IsCancel="True"
                    Click="OkButton_Click" />
        </StackPanel>
    </Grid>
</Window>
