<Window x:Class="MangaMeYeah.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MangaMeYeah"
        Icon="pack://application:,,,/Assets/MangaMeYeah.ico"
        Width="1120"
        Height="800"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing">
    <Grid>
        <!-- メインビューア領域 (通常時は上部メニューバー分 Margin="0,22,0,0"、フルスクリーン時は Margin="0" で画面全体を使用しメニューがオーバーレイでプルダウン) -->
        <Grid x:Name="ViewerRootGrid"
              Margin="0,22,0,0"
              Background="#808080"
              ClipToBounds="True"
              Focusable="True"
              MouseDown="ViewerRootGrid_MouseDown"
              MouseMove="ViewerRootGrid_MouseMove"
              MouseUp="ViewerRootGrid_MouseUp"
              PreviewMouseWheel="ViewerRootGrid_PreviewMouseWheel">

            <!-- 右クリックコンテキストメニュー (MangaMeeya Resource ID: 295 完全再現) -->
            <Grid.ContextMenu>
                <ContextMenu x:Name="ViewerContextMenu">
                <MenuItem Uid="CTX_143" Header="次に進む" Tag="次に進む" Click="MenuItem_Click" />
                <MenuItem Uid="CTX_149" Header="前に戻る" Tag="前に戻る" Click="MenuItem_Click" />
                <Separator />
                <MenuItem Uid="CTX_167" Header="拡大" Tag="拡大" Click="MenuItem_Click" />
                <MenuItem Uid="CTX_168" Header="縮小" Tag="縮小" Click="MenuItem_Click" />
                <Separator />
                <MenuItem Header="移動(_J)">
                    <MenuItem Uid="CTX_143" Header="次に進む" Tag="次に進む" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_144" Header="1ページだけ進む" Tag="1ページだけ進む" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_145" Header="10ページ進む" Tag="10ページ進む" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_146" Header="20ページ進む" Tag="20ページ進む" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_147" Header="50ページ進む" Tag="50ページ進む" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_148" Header="最終ページへ" Tag="最終ページへ" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_190" Header="次のサブフォルダへ" Tag="次のサブフォルダへ" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_188" Header="次のフォルダ(書庫)へ" Tag="次のフォルダ(書庫)へ" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_149" Header="前に戻る" Tag="前に戻る" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_150" Header="1ページだけ戻す" Tag="1ページだけ戻す" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_151" Header="10ページ戻る" Tag="10ページ戻る" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_152" Header="20ページ戻る" Tag="20ページ戻る" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_153" Header="50ページ戻る" Tag="50ページ戻る" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_154" Header="最初のページへ" Tag="最初のページへ" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_191" Header="前のサブフォルダへ" Tag="前のサブフォルダへ" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_189" Header="前のフォルダ(書庫)へ" Tag="前のフォルダ(書庫)へ" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_272" Header="上のフォルダへ(表紙サムネイル)" Tag="上のフォルダへ(表紙サムネイル)" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_155" Header="指定ページへ" Tag="指定ページへ" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_160" Header="ファイルビュー" Tag="ファイルビュー" Click="MenuItem_Click" />
                </MenuItem>
                <MenuItem Header="Avisynthフィルタプロファイル(_P)">
                    <MenuItem Uid="CTX_500" Header="profile" Tag="profile" Click="MenuItem_Click" />
                </MenuItem>
                <MenuItem Header="ファイル(_F)">
                    <MenuItem Uid="CTX_40003" Header="開く" Tag="開く" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_271" Header="フォルダを開く" Tag="フォルダを開く" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_129" Header="保存" Tag="保存" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_280" Header="閉じる" Tag="閉じる" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_281" Header="更新" Tag="更新" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_218" Header="設定ファイルのインポート" Tag="設定ファイルのインポート" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_219" Header="設定ファイルのエクスポート" Tag="設定ファイルのエクスポート" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_40022" Header="クリップボードから貼り付け" Tag="クリップボードから貼り付け" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_40023" Header="クリップボードへコピー" Tag="クリップボードへコピー" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_40047" Header="ページ設定" Tag="ページ設定" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_40048" Header="印刷" Tag="印刷" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_127" Header="終了" Tag="終了" Click="ExitMenuItem_Click" />
                </MenuItem>
                <MenuItem Header="表示(_V)">
                    <MenuItem Uid="CTX_40009" Header="１ページ表示" Tag="１ページ表示" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_40010" Header="２ページ表示" Tag="２ページ表示" Click="MenuItem_Click" />
                    <MenuItem Header="複数枚・連結表示(_M)">
                        <MenuItem Uid="CTX_40010" Header="横2枚表示 (標準見開き)" Tag="横2枚表示" Click="MenuItem_Click" />
                        <MenuItem Uid="CTX_40201" Header="縦2枚表示" Tag="縦2枚表示" Click="MenuItem_Click" />
                        <MenuItem Uid="CTX_40202" Header="横3枚表示" Tag="横3枚表示" Click="MenuItem_Click" />
                        <MenuItem Uid="CTX_40203" Header="縦3枚表示" Tag="縦3枚表示" Click="MenuItem_Click" />
                        <MenuItem Uid="CTX_40204" Header="横4枚表示" Tag="横4枚表示" Click="MenuItem_Click" />
                        <MenuItem Uid="CTX_40205" Header="縦4枚表示" Tag="縦4枚表示" Click="MenuItem_Click" />
                        <MenuItem Uid="CTX_40206" Header="縦横2×2枚表示 (4枚)" Tag="縦横2×2枚表示" Click="MenuItem_Click" />
                    </MenuItem>
                    <MenuItem Header="見開き方向">
                        <MenuItem Uid="CTX_278" Header="左開き" Tag="左開き" Click="MenuItem_Click" />
                        <MenuItem Uid="CTX_279" Header="右開き" Tag="右開き" Click="MenuItem_Click" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Uid="CTX_131" Header="自動見開き表示" Tag="自動見開き表示" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_187" Header="自動単ページ表示(左右分割)" Tag="自動単ページ表示(左右分割)" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_256" Header="自動単ページ表示(上下分割)" Tag="自動単ページ表示(上下分割)" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_40011" Header="サムネイル表示(1画面)" Tag="サムネイル表示(1画面)" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_40012" Header="サムネイル表示(8列)" Tag="サムネイル表示(8列)" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_232" Header="サムネイル表示(カスタム)" Tag="サムネイル表示(カスタム)" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_250" Header="表紙サムネイル" Tag="表紙サムネイル" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_231" Header="サムネイル設定" Tag="サムネイル設定" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_119" Header="フルスクリーン" Tag="フルスクリーン" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_172" Header="ルーペ表示" Tag="ルーペ表示" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_40031" Header="ツールバー表示" Tag="ツールバー表示" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_175" Header="フォルダツリー表示" Tag="フォルダツリー表示" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_195" Header="ブックリスト表示" Tag="ブックリスト表示" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_261" Header="本棚表示" Tag="本棚表示" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_262" Header="目次表示" Tag="目次表示" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_269" Header="別ウインドウ表示" Tag="別ウインドウ表示" Click="MenuItem_Click" />
                </MenuItem>
                <MenuItem Header="スケールモード(_S)">
                    <MenuItem Uid="CTX_40101" Header="縦横どちらか合わせる" Tag="縦横どちらか合わせる" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_40102" Header="ウインドウサイズに合わせる" Tag="ウインドウサイズに合わせる" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_40103" Header="原寸サイズで表示" Tag="原寸サイズで表示" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_40104" Header="画像サイズに合わせる" Tag="画像サイズに合わせる" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_40106" Header="縦サイズを揃える(2ページ表示用)" Tag="縦サイズを揃える(2ページ表示用)" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_40105" Header="指定スケール、サイズで表示" Tag="指定スケール、サイズで表示" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_40100" Header="倍率固定(デフォルト)" Tag="倍率固定(デフォルト)" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_40107" Header="縮小はするが拡大はしない" Tag="縮小はするが拡大はしない" Click="MenuItem_Click" />
                    <Separator />
                    <MenuItem Uid="CTX_350" Header="拡縮処理にHALFTONEフィルタを使う(_Z)" Tag="拡縮処理にHALFTONEフィルタを使う" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_351" Header="拡縮処理に平均画素法を使う(_X)" Tag="拡縮処理に平均画素法を使う" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_352" Header="拡縮処理にLanczosフィルタを使う(_C)" Tag="拡縮処理にLanczosフィルタを使う" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_353" Header="拡縮処理に３次補間(バイキュービック)を使う(_V)" Tag="拡縮処理に３次補間(バイキュービック)を使う" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_354" Header="拡縮処理に線形補間を使う(_B)" Tag="拡縮処理に線形補間を使う" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_355" Header="拡縮処理に平均画素法+シャープネス弱(_N)" Tag="拡縮処理に平均画素法+シャープネス弱" Click="MenuItem_Click" />
                    <MenuItem Uid="CTX_356" Header="拡縮処理に平均画素法+シャープネス強(_M)" Tag="拡縮処理に平均画素法+シャープネス強" Click="MenuItem_Click" />
                </MenuItem>
                </ContextMenu>
            </Grid.ContextMenu>

            <!-- 初期ガイド表示 (画像未読込時) -->
            <StackPanel x:Name="EmptyStatePanel"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        IsHitTestVisible="False">
                <TextBlock Text="MangaMeYeah"
                           Foreground="#D8D8D8"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10" />
                <TextBlock Text="画像ファイルまたはフォルダをここにドラッグ＆ドロップ、またはエクスプローラー右クリック「MangaMeYeahで開く」"
                           Foreground="#CFCFCF"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6" />
                <TextBlock Text="左クリック: 次へ ｜ 右クリック: 前へ ｜ 右ドラッグ: マウスジェスチャ (↖↗↙↘ クイックセーブ1〜4 / → サムネイル選別) ｜ 中クリック: ルーペ"
                           Foreground="#B8B8B8"
                           FontSize="12"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- スクロール＆見開き表示コンテナ -->
            <ScrollViewer x:Name="ImageScrollViewer"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"
                          Focusable="False"
                          PanningMode="Both">
                <Grid x:Name="PageCanvasGrid"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左側画像スロット -->
                    <Image x:Name="LeftPageImage"
                           Grid.Column="0"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True" />

                    <!-- 右側画像スロット -->
                    <Image x:Name="RightPageImage"
                           Grid.Column="1"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True" />
                </Grid>
            </ScrollViewer>

            <!-- ルーペ (拡大鏡) オーバーレイ -->
            <Canvas x:Name="LoupeOverlayCanvas"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <Border x:Name="LoupeBorder"
                        Width="280"
                        Height="280"
                        BorderBrush="#00FF66"
                        BorderThickness="2"
                        Background="#202020"
                        ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.6" />
                    </Border.Effect>
                    <Canvas ClipToBounds="True">
                        <Rectangle x:Name="LoupeViewportRect" Width="280" Height="280">
                            <Rectangle.Fill>
                                <VisualBrush x:Name="LoupeVisualBrush"
                                             Visual="{Binding ElementName=PageCanvasGrid}"
                                             ViewboxUnits="Absolute"
                                             Stretch="None" />
                            </Rectangle.Fill>
                        </Rectangle>
                    </Canvas>
                </Border>
            </Canvas>

            <!-- マウスジェスチャ軌跡＆コマンド名オーバーレイ -->
            <Canvas x:Name="GestureOverlayCanvas"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <Polyline x:Name="GestureTrailPolyline"
                          Stroke="#00FF66"
                          StrokeThickness="3"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                <Border x:Name="GestureBadgeBorder"
                        Canvas.Left="24"
                        Canvas.Top="52"
                        Background="#CC181818"
                        BorderBrush="#00FF66"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,6">
                    <TextBlock x:Name="GestureStatusText"
                               Foreground="#00FF66"
                               FontSize="16"
                               FontWeight="Bold" />
                </Border>
            </Canvas>

            <!-- MangaMeeya風 左上ステータスメッセージ OSD -->
            <Border x:Name="OsdStatusBorder"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="16,28,0,0"
                    Background="#BF141414"
                    BorderBrush="#4000FF66"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,5"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <TextBlock x:Name="OsdStatusText"
                           Foreground="#00FF66"
                           FontSize="14"
                           FontWeight="SemiBold" />
            </Border>

            <!-- サムネイル一覧＆複数選択コレクション画面 (ライトテーブル) -->
            <Grid x:Name="ThumbnailOverlayGrid"
                  Background="#F21E1E1E"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- サムネイル操作＆一括クイックセーブバー -->
                <Border Grid.Row="0"
                        Background="#2D2D30"
                        BorderBrush="#444444"
                        BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <DockPanel LastChildFill="False">
                        <TextBlock x:Name="ThumbSummaryText"
                                   DockPanel.Dock="Left"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"
                                   Text="サムネイル一覧" />

                        <Button Content="全選択"
                                DockPanel.Dock="Left"
                                Padding="8,3"
                                Margin="0,0,6,0"
                                Click="ThumbSelectAll_Click" />
                        <Button Content="選択解除"
                                DockPanel.Dock="Left"
                                Padding="8,3"
                                Margin="0,0,16,0"
                                Click="ThumbClearSelection_Click" />

                        <TextBlock Text="一括クイックセーブ:"
                                   DockPanel.Dock="Left"
                                   Foreground="#CCCCCC"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <Button x:Name="BatchQs1Button"
                                Content="QS1へ保存"
                                DockPanel.Dock="Left"
                                Padding="8,3"
                                Margin="0,0,4,0"
                                Click="BatchQuickSave1_Click" />
                        <Button x:Name="BatchQs2Button"
                                Content="QS2へ保存"
                                DockPanel.Dock="Left"
                                Padding="8,3"
                                Margin="0,0,4,0"
                                Click="BatchQuickSave2_Click" />
                        <Button x:Name="BatchQs3Button"
                                Content="QS3へ保存"
                                DockPanel.Dock="Left"
                                Padding="8,3"
                                Margin="0,0,4,0"
                                Click="BatchQuickSave3_Click" />
                        <Button x:Name="BatchQs4Button"
                                Content="QS4へ保存"
                                DockPanel.Dock="Left"
                                Padding="8,3"
                                Margin="0,0,12,0"
                                Click="BatchQuickSave4_Click" />
                        <Button Content="QS設定..."
                                DockPanel.Dock="Left"
                                Padding="8,3"
                                Click="OpenQuickSaveSettings_Click" />

                        <Button Content="閉じる (Esc)"
                                DockPanel.Dock="Right"
                                Padding="12,3"
                                Click="CloseThumbnailView_Click" />

                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,16,0">
                            <TextBlock Text="サイズ:"
                                       Foreground="#CCCCCC"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <Slider x:Name="ThumbSizeSlider"
                                    Width="110"
                                    Minimum="100"
                                    Maximum="400"
                                    Value="200"
                                    VerticalAlignment="Center"
                                    ValueChanged="ThumbSizeSlider_ValueChanged" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- サムネイル一覧リスト -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="10">
                    <ItemsControl x:Name="ThumbnailItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{Binding DataContext.ThumbnailCardWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Height="{Binding DataContext.ThumbnailCardHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Margin="6"
                                        CornerRadius="4"
                                        Background="#262626"
                                        BorderThickness="2"
                                        MouseLeftButtonDown="ThumbnailCard_MouseLeftButtonDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#3E3E42" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentPage}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#00AAFF" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#00FF66" />
                                                    <Setter Property="Background" Value="#1E3A28" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Image Grid.Row="0"
                                               Source="{Binding ThumbnailBitmap}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <CheckBox Grid.Row="0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Top"
                                                  Margin="4"
                                                  Click="ThumbnailCheckBox_Click">
                                            <CheckBox.LayoutTransform>
                                                <ScaleTransform ScaleX="1.25" ScaleY="1.25" />
                                            </CheckBox.LayoutTransform>
                                        </CheckBox>
                                        <TextBlock Grid.Row="1"
                                                   Foreground="#E0E0E0"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center"
                                                   Margin="2,4,2,0">
                                            <Run Text="{Binding DisplayPageNumber, Mode=OneWay}" FontWeight="Bold" Foreground="#00FF66" />
                                            <Run Text=": " />
                                            <Run Text="{Binding FileName, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- メインメニューバー (最前面の上部に配置、フルスクリーン時はマウスを上端に寄せるとプルダウン表示) -->
        <Menu x:Name="MainMenuBar"
              VerticalAlignment="Top"
              Height="22"
              Panel.ZIndex="100"
              MouseLeave="MainMenuBar_MouseLeave">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Uid="MAIN_40003" Header="開く(_O)..." Tag="開く" Click="MenuItem_Click" />
                <MenuItem Uid="MAIN_271" Header="フォルダを開く(_D)..." Tag="フォルダを開く" Click="MenuItem_Click" />
                <MenuItem Uid="MAIN_338" Header="URL開く(_H)..." Tag="URL開く" Click="MenuItem_Click" />
                <MenuItem Uid="MAIN_365" Header="外部プログラムで開く(_J)" Tag="外部プログラムで開く" Click="MenuItem_Click" />
                <MenuItem Uid="MAIN_366" Header="外部プログラム起動設定(_K)..." Tag="外部プログラム起動設定" Click="MenuItem_Click" />
                <Separator />
